# Backend env
PORT=5000
JWT_SECRET=lostfound-plus-jwt-secret-key-2026

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Backend public URL
APP_URL="http://localhost:5000"

# FRONTEND_URL: Allowed CORS origin for frontend dev server
FRONTEND_URL="http://localhost:5173"

# CLOUDINARY: Item photo storage (backend-only, never exposed to frontend).
# Get these free from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="MY_CLOUDINARY_CLOUD_NAME"
CLOUDINARY_API_KEY="MY_CLOUDINARY_API_KEY"
CLOUDINARY_API_SECRET="MY_CLOUDINARY_API_SECRET"
